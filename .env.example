# Required: key used to encrypt stored connection passwords (any long random string).
# Generate: openssl rand -base64 32
PGCONTROL_SECRET_KEY=

# Initial admin password (used only when no users exist). If empty, a random one is printed to the log.
PGCONTROL_ADMIN_PASSWORD=

# Optional
PGCONTROL_HOST=127.0.0.1
PGCONTROL_PORT=7420
PGCONTROL_DATA_DIR=./data

# Background metrics sampler (seconds between samples, 0 disables; hours of history kept)
PGCONTROL_METRICS_INTERVAL_SECONDS=60
PGCONTROL_METRICS_RETENTION_HOURS=72
