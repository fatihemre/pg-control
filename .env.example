# Required: key used to encrypt stored connection passwords (any long random string).
# Generate: openssl rand -base64 32
PGCONTROL_SECRET_KEY=

# Initial admin password (used only when no users exist). If empty, a random one is printed to the log.
PGCONTROL_ADMIN_PASSWORD=

# Optional
PGCONTROL_HOST=127.0.0.1
PGCONTROL_PORT=7420
PGCONTROL_DATA_DIR=./data

# Metadata database: SQLite file in PGCONTROL_DATA_DIR by default, or a PostgreSQL URL.
# PGCONTROL_DATABASE_URL=postgresql://pgcontrol:secret@127.0.0.1:5432/pgcontrol

# Sessions and login protection
PGCONTROL_SESSION_TTL_HOURS=12
PGCONTROL_LOGIN_MAX_ATTEMPTS=5
PGCONTROL_LOGIN_WINDOW_SECONDS=300
PGCONTROL_LOGIN_LOCKOUT_SECONDS=300

# Behind an HTTPS reverse proxy
# PGCONTROL_SECURE_COOKIES=true
# PGCONTROL_PROXY_HEADERS=true
# PGCONTROL_FORWARDED_ALLOW_IPS=*

# Background metrics sampler (seconds between samples, 0 disables; hours of history kept)
PGCONTROL_METRICS_INTERVAL_SECONDS=60
PGCONTROL_METRICS_RETENTION_HOURS=72

# OpenID Connect single sign-on (optional). Enabled when issuer and client id are set.
# PGCONTROL_OIDC_ISSUER=https://login.example.com/realms/main
# PGCONTROL_OIDC_CLIENT_ID=pgcontrol
# PGCONTROL_OIDC_CLIENT_SECRET=
# PGCONTROL_OIDC_REDIRECT_URL=https://pgcontrol.example.com/api/auth/oidc/callback
# PGCONTROL_OIDC_DISPLAY_NAME=Company SSO
# PGCONTROL_OIDC_USERNAME_CLAIM=preferred_username
# PGCONTROL_OIDC_ROLE_CLAIM=groups
# PGCONTROL_OIDC_ROLE_MAP=pgcontrol-admins:admin,pgcontrol-operators:operator
# PGCONTROL_OIDC_DEFAULT_ROLE=viewer
# PGCONTROL_OIDC_AUTO_CREATE=true
